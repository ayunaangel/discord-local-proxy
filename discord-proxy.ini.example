; Copie este arquivo como discord-proxy.ini.
;
; Windows: %LOCALAPPDATA%\discord-proxy\discord-proxy.ini
; Linux:   ~/.local/share/discord-proxy/discord-proxy.ini
; macOS:   ~/Library/Application Support/discord-proxy/discord-proxy.ini
;
; Ele também pode ficar ao lado do Discord.exe, como no drover.

[discord-proxy]

; Por onde o Discord sai para a internet. É esta linha que muda a região do
; servidor de voz — o mesmo por onde passam a câmera e o compartilhamento de
; tela. Vazio = sai daqui mesmo, sem trocar nada.
;
;   socks5://127.0.0.1:9150                          Tor Browser aberto
;   socks5://127.0.0.1:1080                          túnel SSH (ssh -D 1080 ...)
;   socks5://usuario:senha@servidor.exemplo:1080     proxy com autenticação
;   socks5://usuario:${MINHA_SENHA}@servidor:1080    senha vinda do ambiente
proxy =

; Coisa diferente: mexe no primeiro pacote UDP para furar filtro de DPI.
; NÃO tem efeito sobre região. Ligue só se a voz estiver bloqueada na sua rede.
voice = off

; Pausa em milissegundos usada pelo ajuste de voz. 0 a 1000.
delay = 50

; Arquivo .bin opcional enviado antes do preparo de voz. Não vem no projeto.
packet =

; Caminho manual do executável do Discord. Vazio = detectar sozinho.
discord =
